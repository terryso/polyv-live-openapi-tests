# API基础URL配置
POLYV_API_BASE_URL=https://api.polyv.net
POLYV_APP_ID=your_polyv_app_id
POLYV_APP_SECRET=your_polyv_app_secret
POLYV_USER_ID=your_polyv_user_id

# 测试环境配置
TEST_ENV=development # development, staging, production

# 测试配置
RETRY_ATTEMPTS=3
REQUEST_TIMEOUT=5000

# 报告配置
REPORT_PATH=src/reports
SCREENSHOT_PATH=src/reports/screenshots

# 日志配置
LOG_LEVEL=info # debug, info, warn, error 